# =============================================================================
# Dangg backend — environment variables
# Copy to .env (never committed) and fill in.
# In Dokploy: paste production values into the service's Environment section.
# For local dev: `supabase start` auto-fills the local SUPABASE_* vars.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Local dev: use `supabase start` output. Production: Supabase Cloud project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- MSG91 (SMS / OTP delivery) ----------------------------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DANGG
MSG91_OTP_TEMPLATE_ID=

# --- Razorpay (payments) -----------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (profile pictures) -------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudflare R2 (media uploads — chat, gallery, verification) -------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dangg-media
R2_S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# Public CDN base URL served over R2 (leave empty if no custom domain yet)
R2_PUBLIC_BASE_URL=https://media.dangg.app

# --- Supabase Auth Hook secret -----------------------------------------------
# Copy from Supabase Dashboard > Authentication > Hooks > Send SMS Hook
SEND_SMS_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- FCM (push notifications — future) ---------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Payout configuration ----------------------------------------------------
COIN_VALUE_PAISA=100
PLATFORM_COMMISSION_PCT=30
MIN_PAYOUT_COINS=100
PAYOUT_PROCESSING_DAYS=3

# --- App-level ---------------------------------------------------------------
# Set to "production" in Dokploy. "development" skips MSG91 and logs OTP.
APP_ENV=production
LOG_LEVEL=info
