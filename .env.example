# =============================================================================
# Dangg backend — environment variables
# Copy to .env (never committed) and fill in. `supabase start` auto-fills
# the local SUPABASE_* variables — paste them after the stack first boots.
# =============================================================================

# --- Supabase (local dev — auto-set by `supabase start`) ---------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Production Supabase (filled when you set up the cloud project) ---------
PROD_SUPABASE_URL=
PROD_SUPABASE_ANON_KEY=
PROD_SUPABASE_SERVICE_ROLE_KEY=

# --- MSG91 (SMS delivery for the OTP send-sms-hook) -------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# --- Razorpay (server-side order creation + webhook signature verification) -
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (signed uploads for profile pictures) -----------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- FCM (push notifications) -----------------------------------------------
FCM_PROJECT_ID=
# Service account JSON pasted as a single-line string (escape internal quotes).
FCM_SERVICE_ACCOUNT_JSON=

# --- Supabase Auth Hook secret (shared between Supabase and our hook fn) ----
SEND_SMS_HOOK_SECRET=

# --- Payout configuration (defaults shown; payouts-request snapshots these
#     per request, so changes only affect NEW payouts) ------------------------
COIN_VALUE_PAISA=100               # 1 coin = 100 paisa = ₹1
PLATFORM_COMMISSION_PCT=30         # Platform retains 30% on each payout
MIN_PAYOUT_COINS=100               # Floor on a single payout request
PAYOUT_PROCESSING_DAYS=3           # Displayed to female; admin pays manually

# --- App-level --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
